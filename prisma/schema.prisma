generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// User & Auth Models (NextAuth)
// ==========================================

enum Role {
  OWNER
  ADMIN
  EDITOR
  AUTHOR
  REVIEWER
  MODERATOR
  STAFF
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider
  role          Role      @default(AUTHOR)
  
  accounts      Account[]
  sessions      Session[]
  
  notificationPrefs Json?

  // CMS relationships
  authorId      String?   @unique
  authorProfile Author?   @relation(fields: [authorId], references: [id])
  
  auditLogs     AuditLog[]
  notifications Notification[]
  revisions     ArticleRevision[]
  moderatedComments Comment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// Publication Models
// ==========================================

model Author {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  headline    String?
  role        String?
  overview    String?
  bio         String?
  avatar      String?
  location    String?
  website     String?
  email       String?
  socialLinks Json?
  expertise   String?
  verifiedTitle Boolean @default(false)
  disclosure  String?   @db.Text
  publicContact Boolean @default(true)
  previousSlugs String[] @default([])
  joinedAt    DateTime  @default(now())
  
  user        User?
  articles    Article[]
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  fullTitle   String?
  description String?
  articles    Article[]
}

model Tag {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  articles    Article[]
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  REVIEW
  REVISION_REQUESTED
  REJECTED
  PUBLISHED
}

model Article {
  id          String        @id @default(uuid())
  slug        String        @unique
  previousSlugs String[]    @default([])
  title       String
  deck        String?
  contentHtml String?
  contentJson Json?
  
  // Legacy / Fallback String Authors
  author      String?
  role        String?
  
  // Relational Author
  authorId    String?
  authorModel Author?       @relation(fields: [authorId], references: [id])
  
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  
  status      ArticleStatus @default(DRAFT)
  views       Int           @default(0)
  legacyTags  String[]      @map("tags")
  tags        Tag[]
  featured    Boolean       @default(false)
  homepagePlacement String?
  img         String?
  seoTitle    String?
  seoDesc     String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  scheduledFor DateTime?

  revisions   ArticleRevision[]
  comments    Comment[]
}

// ==========================================
// CMS Operational Models
// ==========================================

model ArticleRevision {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  title        String?
  deck         String?
  contentHtml  String?
  contentJson  Json?
  
  notes        String?  @db.Text
  statusChange String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(AUTHOR)
  token     String   @unique
  expires   DateTime
  status    String   @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  invitedBy String?  
  createdAt DateTime @default(now())
}

// ==========================================
// Audience Models
// ==========================================

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model Subscriber {
  id               String           @id @default(uuid())
  email            String           @unique
  status           SubscriberStatus @default(ACTIVE)
  source           String           @default("HOMEPAGE") // HOMEPAGE, ARTICLE, FOOTER
  consentAt        DateTime         @default(now())
  unsubscribeToken String           @unique @default(uuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

model Comment {
  id            String        @id @default(uuid())
  articleId     String
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleSlug   String
  
  displayName   String
  emailHash     String        // SHA-256 of normalized email for Gravatar — never expose raw email publicly
  email         String        // Stored server-side only, never returned to public clients
  body          String        @db.Text
  
  status        CommentStatus @default(PENDING)
  ipHash        String?       // SHA-256 of IP — for abuse tracking, never stored raw
  userAgent     String?
  
  moderatorId   String?
  moderator     User?         @relation(fields: [moderatorId], references: [id], onDelete: SetNull)
  moderatorNote String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
