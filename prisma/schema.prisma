generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// User & Auth Models (NextAuth)
// ==========================================

enum Role {
  OWNER
  ADMIN
  EDITOR
  AUTHOR
  REVIEWER
  MODERATOR
  STAFF
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider
  role          Role      @default(AUTHOR)
  
  accounts      Account[]
  sessions      Session[]
  
  // CMS relationships
  authorId      String?   @unique
  authorProfile Author?   @relation(fields: [authorId], references: [id])
  
  auditLogs     AuditLog[]
  notifications Notification[]
  revisions     ArticleRevision[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// Publication Models
// ==========================================

model Author {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  headline    String?
  role        String?
  overview    String?
  bio         String?
  avatar      String?
  location    String?
  website     String?
  email       String?
  socialLinks Json?
  joinedAt    DateTime  @default(now())
  
  user        User?
  articles    Article[]
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  fullTitle   String?
  description String?
  articles    Article[]
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  REVIEW
  REVISION_REQUESTED
  REJECTED
  PUBLISHED
}

model Article {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  deck        String?
  contentHtml String?
  contentJson Json?
  
  // Legacy / Fallback String Authors
  author      String?
  role        String?
  
  // Relational Author
  authorId    String?
  authorModel Author?       @relation(fields: [authorId], references: [id])
  
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  
  status      ArticleStatus @default(DRAFT)
  views       Int           @default(0)
  tags        String[]
  featured    Boolean       @default(false)
  img         String?
  seoTitle    String?
  seoDesc     String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  revisions   ArticleRevision[]
}

// ==========================================
// CMS Operational Models
// ==========================================

model ArticleRevision {
  id          String   @id @default(uuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  notes       String?  @db.Text
  statusChange String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(AUTHOR)
  token     String   @unique
  expires   DateTime
  status    String   @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  invitedBy String?  
  createdAt DateTime @default(now())
}
