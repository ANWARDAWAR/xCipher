generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String?           @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              Role              @default(AUTHOR)
  authorId          String?           @unique
  notificationPrefs Json?
  isActive          Boolean           @default(true)
  sessionVersion    Int               @default(1)
  accounts          Account[]
  claimedArticles   Article[]         @relation("ArticleReviewer")
  articleReviews    ArticleReview[]
  revisions         ArticleRevision[]
  auditLogs         AuditLog[]
  moderatedComments Comment[]
  notifications     Notification[]
  sessions          Session[]
  authorProfile     Author?           @relation(fields: [authorId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Author {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  role          String?
  bio           String?
  avatar        String?
  socialLinks   Json?
  joinedAt      DateTime  @default(now())
  email         String?
  headline      String?
  location      String?
  website       String?
  overview      String?
  disclosure    String?   @db.Text
  expertise     String?
  previousSlugs String[]  @default([])
  publicContact Boolean   @default(true)
  verifiedTitle Boolean   @default(false)
  articles      Article[]
  user          User?
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  fullTitle   String?
  description String?
  articles    Article[]
}

model Tag {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  articles    Article[] @relation("ArticleToTag")
}

model Article {
  id                String            @id @default(uuid())
  slug              String            @unique
  title             String
  deck              String?
  contentHtml       String?
  contentJson       Json?
  author            String?
  role              String?
  categoryId        String?
  status            ArticleStatus     @default(DRAFT)
  views             Int               @default(0)
  legacyTags        String[]          @map("tags")
  featured          Boolean           @default(false)
  img               String?
  seoTitle          String?
  seoDesc           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorId          String?
  publishedAt       DateTime?
  scheduledFor      DateTime?
  homepagePlacement String?
  previousSlugs     String[]          @default([])
  approvedAt        DateTime?
  approvedById      String?
  archivedAt        DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  submittedAt       DateTime?
  submittedById     String?
  authorModel       Author?           @relation(fields: [authorId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  reviewer          User?             @relation("ArticleReviewer", fields: [reviewedById], references: [id])
  reviews           ArticleReview[]
  revisions         ArticleRevision[]
  comments          Comment[]
  tags              Tag[]             @relation("ArticleToTag")

  @@index([status, updatedAt])
  @@index([status, submittedAt])
  @@index([authorId, status, updatedAt])
  @@index([categoryId, status, publishedAt])
  @@index([publishedAt])
  @@index([scheduledFor])
}

model ArticleRevision {
  id           String   @id @default(uuid())
  articleId    String
  userId       String
  notes        String?  @db.Text
  statusChange String?
  createdAt    DateTime @default(now())
  contentHtml  String?
  contentJson  Json?
  deck         String?
  title        String?
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])
}

model ArticleReview {
  id         String   @id @default(uuid())
  articleId  String
  reviewerId String
  decision   String
  reason     String?  @db.Text
  reasonCode String?
  fromStatus String
  toStatus   String
  passNumber Int      @default(1)
  createdAt  DateTime @default(now())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id])

  @@index([articleId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(AUTHOR)
  token     String   @unique
  expires   DateTime
  status    String   @default("PENDING")
  invitedBy String?
  createdAt DateTime @default(now())
}

model Subscriber {
  id               String           @id @default(uuid())
  email            String           @unique
  status           SubscriberStatus @default(ACTIVE)
  source           String           @default("HOMEPAGE")
  consentAt        DateTime         @default(now())
  unsubscribeToken String           @unique @default(uuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Comment {
  id            String        @id @default(uuid())
  articleId     String
  articleSlug   String
  displayName   String
  emailHash     String
  email         String
  body          String        @db.Text
  status        CommentStatus @default(PENDING)
  ipHash        String?
  userAgent     String?
  moderatorId   String?
  moderatorNote String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  moderator     User?         @relation(fields: [moderatorId], references: [id])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  AUTHOR
  REVIEWER
  MODERATOR
  STAFF
}

enum ArticleStatus {
  DRAFT
  REVIEW            // Deprecated: superseded by SUBMITTED. Backfilled by migration
                    // 20260918000000_backfill_review_to_submitted. No row holds it and
                    // no code writes it; the value stays only because dropping an enum
                    // value in Postgres requires a destructive type rewrite.
  PUBLISHED
  SUBMITTED
  REVISION_REQUESTED
  REJECTED
  APPROVED
  SCHEDULED
  ARCHIVED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}
