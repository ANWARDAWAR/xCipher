NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
# Optional. Without it the console still works and in-app notifications are
# still written -- only email delivery is skipped. NEXTAUTH_URL is used to build
# absolute links in those emails, so set it too if you enable this.
RESEND_API_KEY="re_your_resend_api_key"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Shared secret for the scheduled-publication cron endpoint.
# Generate with: openssl rand -hex 32
# If unset, /api/cron/publish-scheduled refuses every request.
CRON_SECRET="your-cron-secret"
